{
    "routes": [
        {
            "src": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "portfolio-two-rosy-34.vercel.app"
                }
            ],
            "dest": "https://www.mahenoorshaikh.in/$1",
            "status": 308
        },
        {
            "src": "/404\\.html",
            "dest": "/404.html",
            "status": 404
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/.*",
            "dest": "/404.html",
            "status": 404
        }
    ]
}
