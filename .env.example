# ============================================================
# Environment Variables Example (Client-Side React Configuration)
# Copy this file to .env.local for local overrides.
# NEVER commit your actual .env file to version control.
# ============================================================

# Application Port (Optional, default 3000)
PORT=3000

# Base URL for API requests (if connected to external backend service)
REACT_APP_API_URL=

# Public application URL for production deployment
REACT_APP_PUBLIC_URL=

# Google Analytics 4 measurement ID (G-R974K3STNH).
# Configure in Vercel Project Settings > Environment Variables for custom builds.
REACT_APP_GA_MEASUREMENT_ID=G-R974K3STNH

# Google Search Console HTML verification token.
# Configured via DNS TXT or HTML meta tag.
REACT_APP_GOOGLE_SITE_VERIFICATION=HjdUGLz1wI-U58978j2tA95iQAbMrr5H5mW_0qpv2kU
REACT_APP_BING_SITE_VERIFICATION=

