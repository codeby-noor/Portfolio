# ============================================================
# Environment Variables Example (Client-Side React Configuration)
# Copy this file to .env.local for local overrides.
# NEVER commit your actual .env file to version control.
# ============================================================

# Application Port (Optional, default 3000)
PORT=3000

# Base URL for API requests (if connected to external backend service)
REACT_APP_API_URL=

# Public application URL for production deployment
REACT_APP_PUBLIC_URL=

# Optional Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
# Leave blank to disable analytics. Configure in Vercel Project Settings > Environment Variables.
REACT_APP_GA_MEASUREMENT_ID=

# Optional Search Console / Bing Webmaster HTML verification tokens.
# These are inserted into the production HTML head only when supplied.
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=
